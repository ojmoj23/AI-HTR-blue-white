---
---
<section class="bg-[#F8FAFC] border-y border-gray-100 py-20 lg:py-24">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">

    <div class="text-center mb-14 reveal">
      <span class="text-xs font-semibold text-[#0067B8] uppercase tracking-widest mb-3 block">
        <span class="en">Performance</span>
        <span class="ru">Производительность</span>
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold text-[#1B2A4A]">
        <span class="en">Ready for Industrial-Scale Volumes</span>
        <span class="ru">Готовность к промышленным объёмам</span>
      </h2>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">

      <!-- Stat 1 -->
      <div class="text-center reveal reveal-delay-1">
        <div class="text-5xl lg:text-6xl font-bold text-[#0067B8] mb-2 stat-number" data-target="99" data-suffix="%+">0%</div>
        <div class="text-sm font-semibold text-[#1B2A4A] mb-1">
          <span class="en">Accuracy</span>
          <span class="ru">Точность</span>
        </div>
        <div class="text-xs text-[#6B7280]">
          <span class="en">On complex handwriting</span>
          <span class="ru">На сложных рукописях</span>
        </div>
      </div>

      <!-- Stat 2 -->
      <div class="text-center reveal reveal-delay-2">
        <div class="text-5xl lg:text-6xl font-bold text-[#0067B8] mb-2 stat-number" data-target="1000" data-suffix="+">0</div>
        <div class="text-sm font-semibold text-[#1B2A4A] mb-1">
          <span class="en">Pages / hour</span>
          <span class="ru">Страниц в час</span>
        </div>
        <div class="text-xs text-[#6B7280]">
          <span class="en">Autonomous processing</span>
          <span class="ru">Автономная обработка</span>
        </div>
      </div>

      <!-- Stat 3 -->
      <div class="text-center reveal reveal-delay-3">
        <div class="text-5xl lg:text-6xl font-bold text-[#0067B8] mb-2">0</div>
        <div class="text-sm font-semibold text-[#1B2A4A] mb-1">
          <span class="en">Manual operations</span>
          <span class="ru">Ручных операций</span>
        </div>
        <div class="text-xs text-[#6B7280]">
          <span class="en">Full automation via Hot Folders</span>
          <span class="ru">Полная автоматизация через Hot Folders</span>
        </div>
      </div>

      <!-- Stat 4 -->
      <div class="text-center reveal reveal-delay-4">
        <div class="text-5xl lg:text-6xl font-bold text-[#0067B8] mb-2 stat-number" data-target="15" data-suffix="M+">0</div>
        <div class="text-sm font-semibold text-[#1B2A4A] mb-1">
          <span class="en">Documents processed</span>
          <span class="ru">Документов обработано</span>
        </div>
        <div class="text-xs text-[#6B7280]">
          <span class="en">Trusted by US & European institutions</span>
          <span class="ru">Доверяют в США и Европе</span>
        </div>
      </div>
    </div>

    <!-- Additional bar -->
    <div class="mt-14 bg-white rounded-2xl border border-gray-100 p-8 shadow-sm reveal">
      <div class="grid md:grid-cols-3 gap-8">
        <div class="flex items-center gap-4">
          <div class="w-10 h-10 rounded-xl bg-[#EBF2F8] flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-[#0067B8]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M5 12l4-4m-4 4l4 4" />
            </svg>
          </div>
          <div>
            <div class="text-sm font-semibold text-[#1B2A4A]">
              <span class="en">100% CPU Utilization</span>
              <span class="ru">100% загрузка CPU</span>
            </div>
            <div class="text-xs text-[#6B7280]">
              <span class="en">Optimized for multi-core servers</span>
              <span class="ru">Оптимизация под многоядерные серверы</span>
            </div>
          </div>
        </div>
        <div class="flex items-center gap-4">
          <div class="w-10 h-10 rounded-xl bg-[#EBF2F8] flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-[#0067B8]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9.776c.112-.017.227-.026.344-.026h15.812c.117 0 .232.009.344.026m-16.5 0a2.25 2.25 0 00-1.883 2.542l.857 6a2.25 2.25 0 002.227 1.932H19.05a2.25 2.25 0 002.227-1.932l.857-6a2.25 2.25 0 00-1.883-2.542m-16.5 0V6A2.25 2.25 0 016 3.75h3.879a1.5 1.5 0 011.06.44l2.122 2.12a1.5 1.5 0 001.06.44H18A2.25 2.25 0 0120.25 9v.776" />
            </svg>
          </div>
          <div>
            <div class="text-sm font-semibold text-[#1B2A4A]">
              <span class="en">Preserves Folder Structure</span>
              <span class="ru">Сохраняет структуру папок</span>
            </div>
            <div class="text-xs text-[#6B7280]">
              <span class="en">Processes tens of thousands of files</span>
              <span class="ru">Обрабатывает десятки тысяч файлов</span>
            </div>
          </div>
        </div>
        <div class="flex items-center gap-4">
          <div class="w-10 h-10 rounded-xl bg-[#EBF2F8] flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-[#0067B8]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 14.25l6-6m4.5-3.493V21.75l-3.75-1.5-3.75 1.5-3.75-1.5-3.75 1.5V4.757c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0c1.1.128 1.907 1.077 1.907 2.185z" />
            </svg>
          </div>
          <div>
            <div class="text-sm font-semibold text-[#1B2A4A]">
              <span class="en">Compression up to 15×</span>
              <span class="ru">Сжатие до 15 раз</span>
            </div>
            <div class="text-xs text-[#6B7280]">
              <span class="en">PDF/JP2 without quality loss</span>
              <span class="ru">PDF/JP2 без потери качества</span>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  function animateCounters() {
    document.querySelectorAll<HTMLElement>('.stat-number').forEach(el => {
      const target = parseInt(el.dataset.target || '0');
      const suffix = el.dataset.suffix || '';
      const duration = 2000;
      const start = performance.now();

      function update(now: number) {
        const elapsed = now - start;
        const progress = Math.min(elapsed / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = Math.round(eased * target) + suffix;
        if (progress < 1) requestAnimationFrame(update);
      }
      requestAnimationFrame(update);
    });
  }

  const statsSection = document.querySelector('.stat-number');
  if (statsSection) {
    const obs = new IntersectionObserver(entries => {
      if (entries[0].isIntersecting) {
        animateCounters();
        obs.disconnect();
      }
    }, { threshold: 0.3 });
    obs.observe(statsSection);
  }
</script>
