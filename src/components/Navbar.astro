---
---
<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-transparent"
>
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <nav class="flex items-center justify-between h-16">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 group">
        <div class="w-8 h-8 rounded-lg bg-[#0067B8] flex items-center justify-center">
          <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>
        <span class="font-bold text-lg text-[#1B2A4A] tracking-tight">AI HTR</span>
      </a>

      <!-- Desktop Links -->
      <ul class="hidden md:flex items-center gap-8">
        <li>
          <a href="/#features" class="text-sm font-medium text-[#1B2A4A] hover:text-[#0067B8] transition-colors">
            <span class="en">Features</span>
            <span class="ru">Возможности</span>
          </a>
        </li>
        <li>
          <a href="/#how-it-works" class="text-sm font-medium text-[#1B2A4A] hover:text-[#0067B8] transition-colors">
            <span class="en">How It Works</span>
            <span class="ru">Как работает</span>
          </a>
        </li>
        <li>
          <a href="/#use-cases" class="text-sm font-medium text-[#1B2A4A] hover:text-[#0067B8] transition-colors">
            <span class="en">Use Cases</span>
            <span class="ru">Применение</span>
          </a>
        </li>
        <li>
          <a href="/#contact" class="text-sm font-medium text-[#1B2A4A] hover:text-[#0067B8] transition-colors">
            <span class="en">Contact</span>
            <span class="ru">Контакты</span>
          </a>
        </li>
      </ul>

      <!-- Right side -->
      <div class="flex items-center gap-3">
        <!-- Language toggle -->
        <button
          data-lang-btn
          class="text-xs font-semibold px-3 py-1.5 rounded-full border border-[#1B2A4A]/20 text-[#1B2A4A] hover:border-[#0067B8] hover:text-[#0067B8] transition-all cursor-pointer"
          aria-label="Toggle language"
        >
          RU
        </button>

        <!-- CTA -->
        <a
          href="/#contact"
          class="hidden sm:inline-flex items-center gap-1.5 px-5 py-2 rounded-full bg-[#0067B8] text-white text-sm font-semibold hover:bg-[#0055A0] transition-colors shadow-sm"
        >
          <span class="en">Get Started</span>
          <span class="ru">Начать</span>
        </a>

        <!-- Mobile menu button -->
        <button
          id="mobile-menu-btn"
          class="md:hidden p-2 rounded-lg hover:bg-gray-100 transition-colors"
          aria-label="Menu"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </nav>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden bg-white border-t border-gray-100 shadow-lg"
  >
    <div class="max-w-7xl mx-auto px-6 py-4 flex flex-col gap-4">
      <a href="/#features" class="text-sm font-medium text-[#1B2A4A] hover:text-[#0067B8]">
        <span class="en">Features</span><span class="ru">Возможности</span>
      </a>
      <a href="/#how-it-works" class="text-sm font-medium text-[#1B2A4A] hover:text-[#0067B8]">
        <span class="en">How It Works</span><span class="ru">Как работает</span>
      </a>
      <a href="/#use-cases" class="text-sm font-medium text-[#1B2A4A] hover:text-[#0067B8]">
        <span class="en">Use Cases</span><span class="ru">Применение</span>
      </a>
      <a href="/#contact" class="text-sm font-medium text-[#1B2A4A] hover:text-[#0067B8]">
        <span class="en">Contact</span><span class="ru">Контакты</span>
      </a>
      <a href="/#contact" class="inline-flex justify-center px-5 py-2 rounded-full bg-[#0067B8] text-white text-sm font-semibold">
        <span class="en">Get Started</span><span class="ru">Начать</span>
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
