---
---
<section id="how-it-works" class="bg-white py-20 lg:py-28">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-16 reveal">
      <span class="text-xs font-semibold text-[#0067B8] uppercase tracking-widest mb-3 block">
        <span class="en">Technology</span>
        <span class="ru">Технология</span>
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-[#1B2A4A] leading-tight mb-4">
        <span class="en">How It Works</span>
        <span class="ru">Как это работает</span>
      </h2>
      <p class="text-[#6B7280]">
        <span class="en">Two-stage intelligent processing delivers near-perfect accuracy on any document type.</span>
        <span class="ru">Двухэтапная интеллектуальная обработка обеспечивает практически идеальную точность на любом типе документов.</span>
      </p>
    </div>

    <!-- Steps -->
    <div class="grid lg:grid-cols-2 gap-12 items-center mb-16">

      <!-- Left: Visual pipeline -->
      <div class="reveal reveal-delay-1">
        <div class="bg-[#F8FAFC] rounded-2xl p-8 border border-gray-100">

          <!-- Document input -->
          <div class="flex items-center gap-4 p-4 bg-white rounded-xl border border-gray-100 shadow-sm mb-4">
            <div class="w-10 h-10 rounded-lg bg-[#F5EFE0] flex items-center justify-center">
              <svg class="w-5 h-5 text-[#8B6914]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
              </svg>
            </div>
            <div>
              <div class="text-sm font-semibold text-[#1B2A4A]">
                <span class="en">Handwritten Document</span>
                <span class="ru">Рукописный документ</span>
              </div>
              <div class="text-xs text-[#6B7280]">
                <span class="en">Scan / photo / digital file</span>
                <span class="ru">Скан / фото / цифровой файл</span>
              </div>
            </div>
          </div>

          <!-- Arrow -->
          <div class="flex justify-center my-2">
            <svg class="w-6 h-6 text-[#0067B8]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </div>

          <!-- Stage 1 -->
          <div class="p-5 bg-gradient-to-r from-[#EBF2F8] to-[#EBF2F8]/50 rounded-xl border-l-4 border-[#0067B8] mb-3">
            <div class="flex items-center gap-3 mb-2">
              <span class="w-6 h-6 rounded-full bg-[#0067B8] text-white text-xs font-bold flex items-center justify-center">1</span>
              <span class="text-sm font-semibold text-[#1B2A4A]">
                <span class="en">Visual Analysis</span>
                <span class="ru">Визуальный анализ</span>
              </span>
            </div>
            <p class="text-xs text-[#6B7280] ml-9">
              <span class="en">Computer Vision recognizes character shapes, patterns, and document layout at the pixel level.</span>
              <span class="ru">Computer Vision распознаёт формы символов, паттерны и структуру документа на уровне пикселей.</span>
            </p>
          </div>

          <!-- Stage 2 -->
          <div class="p-5 bg-gradient-to-r from-[#EBF2F8] to-[#EBF2F8]/50 rounded-xl border-l-4 border-[#50A8FF] mb-4">
            <div class="flex items-center gap-3 mb-2">
              <span class="w-6 h-6 rounded-full bg-[#50A8FF] text-white text-xs font-bold flex items-center justify-center">2</span>
              <span class="text-sm font-semibold text-[#1B2A4A]">
                <span class="en">Linguistic Control</span>
                <span class="ru">Лингвистический контроль</span>
              </span>
            </div>
            <p class="text-xs text-[#6B7280] ml-9">
              <span class="en">LLM verifies context, corrects errors, and restores unclear fragments based on meaning.</span>
              <span class="ru">LLM проверяет контекст, исправляет ошибки и восстанавливает неразборчивые фрагменты по смыслу.</span>
            </p>
          </div>

          <!-- Arrow -->
          <div class="flex justify-center my-2">
            <svg class="w-6 h-6 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </div>

          <!-- Output -->
          <div class="flex items-center gap-4 p-4 bg-white rounded-xl border border-green-100 shadow-sm">
            <div class="w-10 h-10 rounded-lg bg-green-50 flex items-center justify-center">
              <svg class="w-5 h-5 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <div class="text-sm font-semibold text-[#1B2A4A]">
                <span class="en">Digitized Text — 99% Accuracy</span>
                <span class="ru">Оцифрованный текст — точность 99%</span>
              </div>
              <div class="text-xs text-[#6B7280]">PDF, TXT, ALTO XML, JP2</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Core advantages -->
      <div class="space-y-6 reveal reveal-delay-2">
        <h3 class="text-2xl font-bold text-[#1B2A4A]">
          <span class="en">Core Technological Advantages</span>
          <span class="ru">Базовые технологические преимущества</span>
        </h3>

        <div class="flex gap-5">
          <div class="w-10 h-10 rounded-xl bg-[#EBF2F8] flex items-center justify-center shrink-0 mt-0.5">
            <span class="text-[#0067B8] font-bold text-sm">1</span>
          </div>
          <div>
            <h4 class="text-base font-semibold text-[#1B2A4A] mb-1">
              <span class="en">Two-Stage Validation</span>
              <span class="ru">Двухэтапная проверка</span>
            </h4>
            <p class="text-[#6B7280] text-sm leading-relaxed">
              <span class="en">Visual recognition of character shapes is supplemented by linguistic context analysis for automatic error correction.</span>
              <span class="ru">Визуальное распознавание форм дополняется лингвистическим анализом контекста для автоматического исправления ошибок.</span>
            </p>
          </div>
        </div>

        <div class="flex gap-5">
          <div class="w-10 h-10 rounded-xl bg-[#EBF2F8] flex items-center justify-center shrink-0 mt-0.5">
            <span class="text-[#0067B8] font-bold text-sm">2</span>
          </div>
          <div>
            <h4 class="text-base font-semibold text-[#1B2A4A] mb-1">
              <span class="en">Supports 100+ Languages</span>
              <span class="ru">Поддержка 100+ языков</span>
            </h4>
            <p class="text-[#6B7280] text-sm leading-relaxed">
              <span class="en">Including historical scripts and dialects: Latin, Ancient Greek, Old Slavonic, Gothic Fraktur, and medieval manuscripts.</span>
              <span class="ru">Включая исторические формы и диалекты: латынь, древнегреческий, старославянский, готический и средневековые манускрипты.</span>
            </p>
          </div>
        </div>

        <div class="flex gap-5">
          <div class="w-10 h-10 rounded-xl bg-[#EBF2F8] flex items-center justify-center shrink-0 mt-0.5">
            <span class="text-[#0067B8] font-bold text-sm">3</span>
          </div>
          <div>
            <h4 class="text-base font-semibold text-[#1B2A4A] mb-1">
              <span class="en">Intelligent Segmentation</span>
              <span class="ru">Интеллектуальная сегментация</span>
            </h4>
            <p class="text-[#6B7280] text-sm leading-relaxed">
              <span class="en">Automatic detection of columns, headings, frames, and complex layouts — even in damaged or multi-column manuscripts.</span>
              <span class="ru">Автоматическое определение колонок, заголовков, рамок и сложной верстки — даже в повреждённых или многоколоночных рукописях.</span>
            </p>
          </div>
        </div>

        <!-- Flexible architecture block -->
        <div class="mt-8 p-6 bg-[#F8FAFC] rounded-2xl border border-gray-100">
          <h4 class="text-base font-semibold text-[#1B2A4A] mb-4">
            <span class="en">Flexible Architecture: Manage AI Parameters</span>
            <span class="ru">Гибкая архитектура: управление параметрами ИИ</span>
          </h4>
          <div class="grid grid-cols-2 gap-3 text-xs text-[#6B7280]">
            <div class="flex items-start gap-2">
              <svg class="w-4 h-4 text-[#0067B8] mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span><span class="en">Prompt customization</span><span class="ru">Кастомизация промптов</span></span>
            </div>
            <div class="flex items-start gap-2">
              <svg class="w-4 h-4 text-[#0067B8] mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span><span class="en">Fine-tuning AI models</span><span class="ru">Тонкая настройка моделей</span></span>
            </div>
            <div class="flex items-start gap-2">
              <svg class="w-4 h-4 text-[#0067B8] mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span><span class="en">Industry-specific adaptation</span><span class="ru">Отраслевая адаптация</span></span>
            </div>
            <div class="flex items-start gap-2">
              <svg class="w-4 h-4 text-[#0067B8] mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span><span class="en">Scenario-based processing</span><span class="ru">Сценарная обработка</span></span>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
