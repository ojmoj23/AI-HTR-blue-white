---
---
<section class="bg-[#1B2A4A] py-20 lg:py-28">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-14 reveal">
      <span class="text-xs font-semibold text-[#50A8FF] uppercase tracking-widest mb-3 block">
        <span class="en">Output Formats</span>
        <span class="ru">Форматы вывода</span>
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">
        <span class="en">Results Matching Global Standards</span>
        <span class="ru">Результаты, соответствующие мировым стандартам</span>
      </h2>
      <p class="text-white/60">
        <span class="en">Export in any format required by your workflow or institution.</span>
        <span class="ru">Экспорт в любом формате, требуемом вашим рабочим процессом или организацией.</span>
      </p>
    </div>

    <!-- Format cards -->
    <div class="grid md:grid-cols-3 gap-6 mb-12">

      <!-- Searchable PDF -->
      <div class="bg-white/5 border border-white/10 rounded-2xl p-8 card-hover reveal reveal-delay-1">
        <div class="w-12 h-12 rounded-xl bg-[#0067B8]/25 flex items-center justify-center mb-5">
          <svg class="w-6 h-6 text-[#50A8FF]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
          </svg>
        </div>
        <div class="text-xs font-bold text-[#50A8FF] uppercase tracking-widest mb-2">Searchable PDF</div>
        <p class="text-white/70 text-sm leading-relaxed">
          <span class="en">Generate Searchable PDF with a unique compression algorithm of <strong class="text-white">up to 15×</strong> while preserving full readability.</span>
          <span class="ru">Формирование Searchable PDF с уникальным алгоритмом сжатия <strong class="text-white">до 15 раз</strong> при сохранении полной читаемости.</span>
        </p>
      </div>

      <!-- ALTO / METS XML -->
      <div class="bg-white/5 border border-white/10 rounded-2xl p-8 card-hover reveal reveal-delay-2">
        <div class="w-12 h-12 rounded-xl bg-[#0067B8]/25 flex items-center justify-center mb-5">
          <svg class="w-6 h-6 text-[#50A8FF]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" />
          </svg>
        </div>
        <div class="text-xs font-bold text-[#50A8FF] uppercase tracking-widest mb-2">ALTO / METS XML</div>
        <p class="text-white/70 text-sm leading-relaxed">
          <span class="en">Support for professional standards for digital libraries: ALTO / METS XML. Perfect for integration into existing archival systems.</span>
          <span class="ru">Поддержка профессиональных стандартов для цифровых библиотек: ALTO / METS XML. Идеально для интеграции в существующие архивные системы.</span>
        </p>
      </div>

      <!-- Elastic Search -->
      <div class="bg-white/5 border border-white/10 rounded-2xl p-8 card-hover reveal reveal-delay-3">
        <div class="w-12 h-12 rounded-xl bg-[#0067B8]/25 flex items-center justify-center mb-5">
          <svg class="w-6 h-6 text-[#50A8FF]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
          </svg>
        </div>
        <div class="text-xs font-bold text-[#50A8FF] uppercase tracking-widest mb-2">Elastic Search</div>
        <p class="text-white/70 text-sm leading-relaxed">
          <span class="en">Integration with Elastic Search for instant search across millions of handwritten pages.</span>
          <span class="ru">Интеграция с Elastic Search для мгновенного поиска по миллионам рукописных страниц.</span>
        </p>
      </div>
    </div>

    <!-- Additional formats strip -->
    <div class="bg-white/5 border border-white/10 rounded-2xl p-6 reveal">
      <div class="flex flex-wrap items-center justify-center gap-6 md:gap-10">
        <span class="text-xs text-white/40 font-medium uppercase tracking-widest hidden sm:block">
          <span class="en">Also supports:</span>
          <span class="ru">Также поддерживает:</span>
        </span>
        <span class="px-4 py-2 bg-white/10 rounded-lg text-sm font-semibold text-white/80">TXT</span>
        <span class="px-4 py-2 bg-white/10 rounded-lg text-sm font-semibold text-white/80">JP2</span>
        <span class="px-4 py-2 bg-white/10 rounded-lg text-sm font-semibold text-white/80">ALTO XML</span>
        <span class="px-4 py-2 bg-white/10 rounded-lg text-sm font-semibold text-white/80">PDF/A</span>
        <span class="px-4 py-2 bg-white/10 rounded-lg text-sm font-semibold text-white/80">Hot Folders</span>
      </div>
    </div>

  </div>
</section>
