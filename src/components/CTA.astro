---
---
<section id="contact" class="bg-white py-20 lg:py-28">
  <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center">

    <!-- Main CTA block -->
    <div class="bg-gradient-to-br from-[#1B2A4A] to-[#0F1E38] rounded-3xl p-12 lg:p-16 reveal relative overflow-hidden">

      <!-- Background decoration -->
      <div class="absolute top-0 right-0 w-64 h-64 rounded-full"
           style="background: radial-gradient(circle, rgba(0,103,184,0.3) 0%, transparent 70%); transform: translate(30%, -30%);">
      </div>
      <div class="absolute bottom-0 left-0 w-48 h-48 rounded-full"
           style="background: radial-gradient(circle, rgba(80,168,255,0.15) 0%, transparent 70%); transform: translate(-30%, 30%);">
      </div>

      <div class="relative z-10">
        <span class="text-xs font-semibold text-[#50A8FF] uppercase tracking-widest mb-4 block">
          <span class="en">Get Started</span>
          <span class="ru">Начать работу</span>
        </span>

        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white leading-tight mb-5">
          <span class="en">Ready to Transform Your Archive?</span>
          <span class="ru">Готовы преобразить ваш архив?</span>
        </h2>

        <p class="text-white/70 text-lg mb-10 max-w-xl mx-auto leading-relaxed">
          <span class="en">Join leading institutions in the US and Europe. Get a demo and see AI HTR process your documents in real time.</span>
          <span class="ru">Присоединяйтесь к ведущим организациям США и Европы. Получите демо и увидьте, как AI HTR обрабатывает ваши документы в реальном времени.</span>
        </p>

        <!-- Email form -->
        <form class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto mb-8" onsubmit="return false;">
          <input
            type="email"
            placeholder="your@email.com"
            class="flex-1 px-5 py-3.5 rounded-full bg-white/10 border border-white/20 text-white placeholder-white/40 text-sm focus:outline-none focus:border-[#50A8FF] focus:bg-white/15 transition-all"
          />
          <button
            type="submit"
            class="px-7 py-3.5 rounded-full bg-[#0067B8] text-white font-semibold text-sm hover:bg-[#0055A0] transition-all shadow-lg hover:shadow-[#0067B8]/40 whitespace-nowrap"
          >
            <span class="en">Request Demo</span>
            <span class="ru">Запросить демо</span>
          </button>
        </form>

        <p class="text-white/40 text-xs">
          <span class="en">No spam. We'll respond within 24 hours.</span>
          <span class="ru">Без спама. Ответим в течение 24 часов.</span>
        </p>
      </div>
    </div>

    <!-- Trust logos strip -->
    <div class="mt-12 reveal reveal-delay-1">
      <p class="text-xs text-[#6B7280] uppercase tracking-widest font-medium mb-6">
        <span class="en">Trusted by institutions in</span>
        <span class="ru">Доверяют организации в</span>
      </p>
      <div class="flex flex-wrap items-center justify-center gap-8 opacity-40">
        <span class="text-lg font-bold text-[#1B2A4A] tracking-wide">🇺🇸 USA</span>
        <span class="text-lg font-bold text-[#1B2A4A] tracking-wide">🇩🇪 Germany</span>
        <span class="text-lg font-bold text-[#1B2A4A] tracking-wide">🇫🇷 France</span>
        <span class="text-lg font-bold text-[#1B2A4A] tracking-wide">🇬🇧 UK</span>
        <span class="text-lg font-bold text-[#1B2A4A] tracking-wide">🇳🇱 Netherlands</span>
      </div>
    </div>

  </div>
</section>

<!-- Footer -->
<footer class="bg-[#F8FAFC] border-t border-gray-100 py-8">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2">
        <div class="w-7 h-7 rounded-lg bg-[#0067B8] flex items-center justify-center">
          <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>
        <span class="font-bold text-[#1B2A4A]">AI HTR</span>
      </div>
      <p class="text-xs text-[#6B7280]">
        <span class="en">© 2025 AI HTR. Advanced Handwritten Text Recognition.</span>
        <span class="ru">© 2025 AI HTR. Передовое распознавание рукописного текста.</span>
      </p>
      <div class="flex items-center gap-4 text-xs text-[#6B7280]">
        <a href="#" class="hover:text-[#0067B8] transition-colors">
          <span class="en">Privacy</span><span class="ru">Конфиденциальность</span>
        </a>
        <a href="#" class="hover:text-[#0067B8] transition-colors">
          <span class="en">Terms</span><span class="ru">Условия</span>
        </a>
      </div>
    </div>
  </div>
</footer>
