---
---
<section id="use-cases" class="bg-[#F8FAFC] py-20 lg:py-28">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-16 reveal">
      <span class="text-xs font-semibold text-[#0067B8] uppercase tracking-widest mb-3 block">
        <span class="en">Use Cases</span>
        <span class="ru">Применение</span>
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-[#1B2A4A] leading-tight mb-4">
        <span class="en">Target Use Cases &amp; Cross-Industry Markets</span>
        <span class="ru">Целевые задачи и кросс-отраслевые рынки</span>
      </h2>
      <p class="text-[#6B7280]">
        <span class="en">AI HTR serves institutions and businesses across multiple sectors with tailored recognition capabilities.</span>
        <span class="ru">AI HTR обслуживает организации и бизнес в разных отраслях с адаптированными возможностями распознавания.</span>
      </p>
    </div>

    <!-- Markets grid -->
    <div class="grid md:grid-cols-2 gap-6">

      <!-- Academic -->
      <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-sm card-hover reveal reveal-delay-1">
        <div class="flex items-start gap-5">
          <div class="w-14 h-14 rounded-2xl bg-[#EBF2F8] flex items-center justify-center shrink-0">
            <svg class="w-7 h-7 text-[#0067B8]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-semibold text-[#1B2A4A] mb-2">
              <span class="en">Academic Sector</span>
              <span class="ru">Академический сектор</span>
            </h3>
            <p class="text-[#6B7280] text-sm leading-relaxed mb-4">
              <span class="en">Digitization of collections and full-text search for national archives, libraries, and historical researchers.</span>
              <span class="ru">Оцифровка фондов и полнотекстовый поиск для национальных архивов, библиотек, НИИ и исследователей-историков.</span>
            </p>
            <div class="flex flex-wrap gap-2">
              <span class="text-xs px-3 py-1 rounded-full bg-[#EBF2F8] text-[#0067B8] font-medium">
                <span class="en">National Archives</span><span class="ru">Национальные архивы</span>
              </span>
              <span class="text-xs px-3 py-1 rounded-full bg-[#EBF2F8] text-[#0067B8] font-medium">
                <span class="en">Libraries</span><span class="ru">Библиотеки</span>
              </span>
              <span class="text-xs px-3 py-1 rounded-full bg-[#EBF2F8] text-[#0067B8] font-medium">
                <span class="en">Research Institutes</span><span class="ru">НИИ</span>
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Genealogy -->
      <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-sm card-hover reveal reveal-delay-2">
        <div class="flex items-start gap-5">
          <div class="w-14 h-14 rounded-2xl bg-[#EBF2F8] flex items-center justify-center shrink-0">
            <svg class="w-7 h-7 text-[#0067B8]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-semibold text-[#1B2A4A] mb-2">
              <span class="en">Genealogy</span>
              <span class="ru">Генеалогия</span>
            </h3>
            <p class="text-[#6B7280] text-sm leading-relaxed mb-4">
              <span class="en">Automated processing of civil registry and religious records. Instant search across millions of handwritten pages.</span>
              <span class="ru">Автоматическая обработка метрических и церковных книг. Мгновенный поиск по миллионам рукописных страниц.</span>
            </p>
            <div class="flex flex-wrap gap-2">
              <span class="text-xs px-3 py-1 rounded-full bg-[#EBF2F8] text-[#0067B8] font-medium">
                <span class="en">Civil Registry</span><span class="ru">Метрические книги</span>
              </span>
              <span class="text-xs px-3 py-1 rounded-full bg-[#EBF2F8] text-[#0067B8] font-medium">
                <span class="en">Church Records</span><span class="ru">Церковные книги</span>
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Medicine & Law -->
      <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-sm card-hover reveal reveal-delay-3">
        <div class="flex items-start gap-5">
          <div class="w-14 h-14 rounded-2xl bg-[#EBF2F8] flex items-center justify-center shrink-0">
            <svg class="w-7 h-7 text-[#0067B8]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 01-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 011.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 00-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 01-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 00-3.375-3.375h-1.5a1.125 1.125 0 01-1.125-1.125v-1.5a3.375 3.375 0 00-3.375-3.375H9.75" />
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-semibold text-[#1B2A4A] mb-2">
              <span class="en">Medicine &amp; Law</span>
              <span class="ru">Медицина и право</span>
            </h3>
            <p class="text-[#6B7280] text-sm leading-relaxed mb-4">
              <span class="en">Digitization of old handwritten case files and medical archives. AI is pre-configured to understand legal and medical terminology.</span>
              <span class="ru">Оцифровка старых рукописных дел и медкарт. ИИ заранее настроен на понимание юридической и медицинской терминологии.</span>
            </p>
            <div class="flex flex-wrap gap-2">
              <span class="text-xs px-3 py-1 rounded-full bg-[#EBF2F8] text-[#0067B8] font-medium">
                <span class="en">Court Records</span><span class="ru">Судебные дела</span>
              </span>
              <span class="text-xs px-3 py-1 rounded-full bg-[#EBF2F8] text-[#0067B8] font-medium">
                <span class="en">Medical Archives</span><span class="ru">Медицинские архивы</span>
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Adjacent Markets -->
      <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-sm card-hover reveal reveal-delay-4">
        <div class="flex items-start gap-5">
          <div class="w-14 h-14 rounded-2xl bg-[#EBF2F8] flex items-center justify-center shrink-0">
            <svg class="w-7 h-7 text-[#0067B8]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0012 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75z" />
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-semibold text-[#1B2A4A] mb-2">
              <span class="en">Adjacent Markets</span>
              <span class="ru">Смежные рынки</span>
            </h3>
            <p class="text-[#6B7280] text-sm leading-relaxed mb-4">
              <span class="en">Automated data anonymization for banks and text extraction from oil and gas engineering drawings.</span>
              <span class="ru">Автоматическая анонимизация данных для банков и извлечение текста из нефтегазовых чертежей.</span>
            </p>
            <div class="flex flex-wrap gap-2">
              <span class="text-xs px-3 py-1 rounded-full bg-[#EBF2F8] text-[#0067B8] font-medium">
                <span class="en">Banking</span><span class="ru">Банки</span>
              </span>
              <span class="text-xs px-3 py-1 rounded-full bg-[#EBF2F8] text-[#0067B8] font-medium">
                <span class="en">Oil &amp; Gas</span><span class="ru">Нефтегаз</span>
              </span>
              <span class="text-xs px-3 py-1 rounded-full bg-[#EBF2F8] text-[#0067B8] font-medium">
                <span class="en">Engineering</span><span class="ru">Инженерия</span>
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
