---
---
<section class="bg-white py-20 lg:py-28">
  <div class="max-w-5xl mx-auto px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center mb-14 reveal">
      <span class="text-xs font-semibold text-[#0067B8] uppercase tracking-widest mb-3 block">
        <span class="en">Comparison</span>
        <span class="ru">Сравнение</span>
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold text-[#1B2A4A] mb-4">
        <span class="en">AI HTR vs. Traditional Solutions</span>
        <span class="ru">AI HTR vs Традиционные решения</span>
      </h2>
    </div>

    <!-- Table -->
    <div class="reveal reveal-delay-1 overflow-x-auto">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr class="bg-[#F8FAFC]">
            <th class="text-left px-6 py-4 text-[#6B7280] font-semibold rounded-tl-xl border border-gray-100">
              <span class="en">Criterion</span>
              <span class="ru">Критерий</span>
            </th>
            <th class="text-left px-6 py-4 text-[#0067B8] font-semibold bg-[#EBF2F8] border-x border-[#0067B8]/20">
              AI HTR
            </th>
            <th class="text-left px-6 py-4 text-[#6B7280] font-semibold rounded-tr-xl border border-gray-100">
              <span class="en">Traditional OCR</span>
              <span class="ru">Традиционный OCR</span>
            </th>
          </tr>
        </thead>
        <tbody>

          <tr class="border-b border-gray-50 hover:bg-[#F8FAFC] transition-colors">
            <td class="px-6 py-5 font-semibold text-[#1B2A4A] border border-gray-100">
              <span class="en">Accuracy</span>
              <span class="ru">Точность</span>
            </td>
            <td class="px-6 py-5 bg-[#EBF2F8]/60 border-x border-[#0067B8]/10">
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-green-500 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                </svg>
                <span class="font-semibold text-[#1B2A4A]">
                  <span class="en">Up to 99% and above</span>
                  <span class="ru">До 99% и выше</span>
                </span>
              </div>
            </td>
            <td class="px-6 py-5 border border-gray-100 text-[#6B7280]">
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-red-400 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
                </svg>
                <span>
                  <span class="en">Practically no usable results on complex handwriting</span>
                  <span class="ru">Практически отсутствует на сложных рукописях</span>
                </span>
              </div>
            </td>
          </tr>

          <tr class="border-b border-gray-50 hover:bg-[#F8FAFC] transition-colors">
            <td class="px-6 py-5 font-semibold text-[#1B2A4A] border border-gray-100">
              <span class="en">Time to Deploy</span>
              <span class="ru">Запуск в работу</span>
            </td>
            <td class="px-6 py-5 bg-[#EBF2F8]/60 border-x border-[#0067B8]/10">
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-green-500 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                </svg>
                <span class="font-semibold text-[#1B2A4A]">
                  <span class="en">Immediate setup</span>
                  <span class="ru">Немедленная установка</span>
                </span>
              </div>
            </td>
            <td class="px-6 py-5 border border-gray-100 text-[#6B7280]">
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-red-400 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
                </svg>
                <span>
                  <span class="en">Weeks of manual work for annotation and neural network training</span>
                  <span class="ru">Недели ручной работы на разметку и обучение нейросети</span>
                </span>
              </div>
            </td>
          </tr>

          <tr class="border-b border-gray-50 hover:bg-[#F8FAFC] transition-colors">
            <td class="px-6 py-5 font-semibold text-[#1B2A4A] border border-gray-100">
              <span class="en">Proven Reliability</span>
              <span class="ru">Доказанная надёжность</span>
            </td>
            <td class="px-6 py-5 bg-[#EBF2F8]/60 border-x border-[#0067B8]/10">
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-green-500 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                </svg>
                <span class="font-semibold text-[#1B2A4A]">
                  <span class="en">Successfully integrated into projects of leading institutions in the US and Europe</span>
                  <span class="ru">Успешно интегрирована в проекты ведущих институтов и архивов США и Европы</span>
                </span>
              </div>
            </td>
            <td class="px-6 py-5 border border-gray-100 text-[#6B7280]">
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-yellow-400 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
                </svg>
                <span>
                  <span class="en">Limited applicability to historical documents</span>
                  <span class="ru">Ограниченная применимость к историческим документам</span>
                </span>
              </div>
            </td>
          </tr>

          <tr class="hover:bg-[#F8FAFC] transition-colors">
            <td class="px-6 py-5 font-semibold text-[#1B2A4A] border border-gray-100 rounded-bl-xl">
              <span class="en">Cost of Digitization</span>
              <span class="ru">Стоимость оцифровки</span>
            </td>
            <td class="px-6 py-5 bg-[#EBF2F8]/60 border-x border-[#0067B8]/10">
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-green-500 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                </svg>
                <span class="font-semibold text-[#1B2A4A]">
                  <span class="en">Comparable to plain printed text — most competitive on the market</span>
                  <span class="ru">Сопоставима с печатным текстом — одни из самых конкурентных условий</span>
                </span>
              </div>
            </td>
            <td class="px-6 py-5 border border-gray-100 text-[#6B7280] rounded-br-xl">
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-red-400 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
                </svg>
                <span>
                  <span class="en">Very high due to manual labor and retraining costs</span>
                  <span class="ru">Очень высокая из-за ручного труда и переобучения</span>
                </span>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Bottom note -->
    <div class="mt-8 p-6 bg-[#EBF2F8] rounded-2xl flex items-start gap-4 reveal reveal-delay-2">
      <div class="w-8 h-8 rounded-lg bg-[#0067B8] flex items-center justify-center shrink-0 mt-0.5">
        <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <p class="text-sm text-[#1B2A4A] font-medium leading-relaxed">
        <span class="en">AI HTR is not just an improved OCR. It is a fundamentally new approach to digitizing handwritten heritage, ready to work from day one.</span>
        <span class="ru">AI HTR — это не просто улучшенный OCR. Это принципиально новый подход к оцифровке рукописного наследия, готовый к работе с первого дня.</span>
      </p>
    </div>

  </div>
</section>
