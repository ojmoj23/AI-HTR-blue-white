---
---
<section class="relative min-h-screen flex items-center overflow-hidden bg-white pt-16">

  <!-- Background gradient blobs -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute -top-32 -right-32 w-[600px] h-[600px] rounded-full"
         style="background: radial-gradient(circle, rgba(0,103,184,0.08) 0%, transparent 70%);">
    </div>
    <div class="absolute bottom-0 left-0 w-[400px] h-[400px] rounded-full"
         style="background: radial-gradient(circle, rgba(0,103,184,0.05) 0%, transparent 70%);">
    </div>
  </div>

  <div class="relative max-w-7xl mx-auto px-6 lg:px-8 w-full py-20 lg:py-28">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">

      <!-- Left: Text -->
      <div>
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#EBF2F8] text-[#0067B8] text-xs font-semibold mb-6 reveal">
          <span class="w-1.5 h-1.5 rounded-full bg-[#0067B8] animate-pulse"></span>
          <span class="en">AI-Powered Handwriting Recognition</span>
          <span class="ru">Распознавание рукописей на базе ИИ</span>
        </div>

        <!-- Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-[1.1] tracking-tight text-[#1B2A4A] mb-6 reveal reveal-delay-1">
          <span class="en-block">
            The Future of<br/>
            Digitizing <span class="gradient-text">Handwritten</span><br/>
            Heritage
          </span>
          <span class="ru-block">
            Будущее оцифровки<br/>
            <span class="gradient-text">рукописного</span><br/>
            наследия
          </span>
        </h1>

        <!-- Subtitle -->
        <p class="text-lg text-[#6B7280] leading-relaxed mb-8 max-w-lg reveal reveal-delay-2">
          <span class="en">
            Advanced handwritten text recognition (HTR) technologies for archives, libraries, research centers, and businesses. Up to 99% accuracy — ready from day one.
          </span>
          <span class="ru">
            Передовые технологии распознавания рукописного текста (HTR) для архивов, библиотек, исследовательских институтов и бизнеса. Точность до 99% — готова с первого дня.
          </span>
        </p>

        <!-- CTAs -->
        <div class="flex flex-wrap gap-4 reveal reveal-delay-3">
          <a
            href="#contact"
            class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-[#0067B8] text-white font-semibold text-sm hover:bg-[#0055A0] transition-all shadow-lg shadow-[#0067B8]/25 hover:shadow-[#0067B8]/40"
          >
            <span class="en">Get Started</span>
            <span class="ru">Начать работу</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
          <a
            href="#features"
            class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full border-2 border-[#1B2A4A]/15 text-[#1B2A4A] font-semibold text-sm hover:border-[#0067B8] hover:text-[#0067B8] transition-all"
          >
            <span class="en">Learn More</span>
            <span class="ru">Подробнее</span>
          </a>
        </div>

        <!-- Trust signal -->
        <div class="flex items-center gap-6 mt-10 reveal reveal-delay-4">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-[#0067B8]" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
            </svg>
            <span class="text-sm text-[#6B7280] font-medium">
              <span class="en">15M+ documents processed</span>
              <span class="ru">15M+ обработанных документов</span>
            </span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-[#0067B8]" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
            </svg>
            <span class="text-sm text-[#6B7280] font-medium">
              <span class="en">US & European institutions</span>
              <span class="ru">США и Европа</span>
            </span>
          </div>
        </div>
      </div>

      <!-- Right: Visual -->
      <div class="relative reveal reveal-delay-2">
        <!-- Main card -->
        <div class="relative rounded-2xl overflow-hidden shadow-2xl shadow-[#1B2A4A]/20">
          <!-- Real manuscript photo -->
          <div class="aspect-[4/3] relative overflow-hidden">
            <img
              src="/hero-manuscript.png"
              alt="AI HTR — handwritten manuscript recognition"
              class="w-full h-full object-cover object-center"
              loading="eager"
            />

            <!-- Subtle dark gradient at bottom for overlay readability -->
            <div class="absolute inset-0 bg-gradient-to-t from-[#1B2A4A]/60 via-transparent to-transparent"></div>

            <!-- AI Recognition overlay -->
            <div class="absolute inset-0 flex items-end p-3 sm:p-4">
              <div class="bg-white/90 backdrop-blur-sm rounded-xl p-2.5 sm:p-4 w-full shadow-lg border border-white/80">
                <div class="flex items-center gap-2 sm:mb-3">
                  <div class="w-2 h-2 rounded-full bg-green-500 animate-pulse shrink-0"></div>
                  <span class="text-xs font-semibold text-[#1B2A4A] uppercase tracking-wide">
                    <span class="en">AI Recognition Active</span>
                    <span class="ru">ИИ распознаёт...</span>
                  </span>
                  <span class="ml-auto text-xs font-bold text-green-600">99.2%</span>
                </div>
                <!-- Progress bars — hidden on mobile, visible from sm -->
                <div class="hidden sm:block space-y-2">
                  <div class="flex items-center gap-2">
                    <div class="flex-1 h-1.5 bg-gray-100 rounded-full overflow-hidden">
                      <div class="h-full bg-[#0067B8] rounded-full" style="width: 97%"></div>
                    </div>
                    <span class="text-[10px] text-gray-400 w-12"><span class="en">Line 1</span><span class="ru">Строка 1</span></span>
                  </div>
                  <div class="flex items-center gap-2">
                    <div class="flex-1 h-1.5 bg-gray-100 rounded-full overflow-hidden">
                      <div class="h-full bg-[#0067B8] rounded-full" style="width: 100%"></div>
                    </div>
                    <span class="text-[10px] text-gray-400 w-12"><span class="en">Line 2</span><span class="ru">Строка 2</span></span>
                  </div>
                  <div class="flex items-center gap-2">
                    <div class="flex-1 h-1.5 bg-gray-100 rounded-full overflow-hidden">
                      <div class="h-full bg-[#50A8FF] rounded-full animate-pulse" style="width: 73%"></div>
                    </div>
                    <span class="text-[10px] text-gray-400 w-12"><span class="en">Line 3</span><span class="ru">Строка 3</span></span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Floating stat cards (hidden on small screens) -->
        <div class="hidden sm:block absolute -top-4 -left-4 bg-white rounded-xl shadow-lg p-3 border border-gray-100">
          <div class="text-2xl font-bold text-[#0067B8]">99%</div>
          <div class="text-xs text-[#6B7280] font-medium">
            <span class="en">Accuracy</span>
            <span class="ru">Точность</span>
          </div>
        </div>

        <div class="hidden sm:block absolute -bottom-4 -right-4 bg-white rounded-xl shadow-lg p-3 border border-gray-100">
          <div class="text-2xl font-bold text-[#0067B8]">40+</div>
          <div class="text-xs text-[#6B7280] font-medium">
            <span class="en">Languages</span>
            <span class="ru">Языков</span>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-40">
    <svg class="w-4 h-4 text-[#1B2A4A] animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
    </svg>
  </div>
</section>
